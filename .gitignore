#Pychram files
.idea/*

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# ANTLR generation-time intermediates (regenerated by tools/gen_speedy_antlr.py)
wwpdb/utils/nmr/cpp_src/*.interp
wwpdb/utils/nmr/cpp_src/*.tokens

# C extensions
# Covers the compiled speedy-antlr-tool accelerators
# (wwpdb/utils/nmr/{mr,pk,cs}/sa_*_cpp_parser*.so). Their generated C++ sources
# and the bundled ANTLR4 C++ runtime under wwpdb/utils/nmr/cpp_src ARE tracked,
# so the container image can compile them without Java or the .g4 grammars.
*.so

# Distribution / packaging
.Python
build/
