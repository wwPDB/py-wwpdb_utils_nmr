recursive-include wwpdb/utils/nmr/bmrb_cs_stat *.csv *.pkl
recursive-include wwpdb/utils/nmr/nmr-star_schema *.csv
recursive-include wwpdb/utils/nmr/chem_comp_util *.pkl

# The speedy-antlr-tool C++ accelerator sources, and c_listener_util.c beside them,
# are only built for the container image (see the Dockerfile builder stage); the
# sdist and source wheel published to PyPI stay pure Python and fall back to the
# ANTLR Python runtime and to the Python bodies in mr/ParserListenerUtil.py.
prune wwpdb/utils/nmr/cpp_src

prune wwpdb/utils/nmr/obsolete
prune wwpdb/utils/tests-nmr/obsolete
prune wwpdb/utils/nmr/nef/NefTranslator/lib
prune wwpdb/utils/nmr/ann/lib

global-exclude */__pycache__/*
global-exclude *.pyc
